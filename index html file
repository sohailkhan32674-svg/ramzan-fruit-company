.toast{
  position:fixed;
  left:50%;
  bottom:25px;
  transform:translateX(-50%) translateY(100px);
  background:#18251d;
  color:white;
  padding:13px 20px;
  border-radius:30px;
  z-index:3000;
  transition:.3s;
}
.toast.show{
  transform:translateX(-50%) translateY(0);
}

