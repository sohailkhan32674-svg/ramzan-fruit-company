}
nav a{
  color:#18251d;
  text-decoration:none;
  padding:9px 12px;
  border-radius:20px;
  font-weight:700;
}
nav a:hover{
  background:#eaf7ee;
  color:var(--green);
}

.hero{
  min-height:75vh;
